        <mxCell id="skip-r0" value="custom_standardization()&lt;br&gt;(tf.strings.lower + regex_replace)&lt;br&gt;layers.TextVectorization()" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
