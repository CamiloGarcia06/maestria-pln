          <mxGeometry x="430" y="80" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cbow-r1" value="nltk.FreqDist(data)&lt;br&gt;get_dict(data) → word2Ind, Ind2word&lt;br&gt;get_vectors() / get_idx()&lt;br&gt;pack_idx_with_frequency()&lt;br&gt;get_batches()  (one-hot promedio del contexto)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="430" y="200" width="300" height="120" as="geometry" />
