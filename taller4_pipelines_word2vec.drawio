        <mxCell id="cbow-t" value="Pipeline PLN — word2vec CBOW (CBOW implementacion ejemplo.ipynb · shakespeare.txt)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cbow-h0" value="Tokenización" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cbow-r0" value="re.sub(r'[,!?;-]', '.', data)&lt;br&gt;nltk.word_tokenize(data)&lt;br&gt;lower() + isalpha()" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
