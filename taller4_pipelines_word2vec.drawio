          <mxGeometry x="820" y="80" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cbow-r2" value="CBOW (red neuronal en NumPy)&lt;br&gt;initialize_model(N, V)&lt;br&gt;forward_prop() + softmax()&lt;br&gt;compute_cost() + back_prop()&lt;br&gt;gradient_descent()" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="820" y="200" width="300" height="120" as="geometry" />
        </mxCell>
